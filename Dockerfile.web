ARG PYTHON_IMAGE=docker.1ms.run/library/python:3.12-slim
FROM --platform=$TARGETPLATFORM ${PYTHON_IMAGE}

ARG TARGETPLATFORM
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg ca-certificates curl chromium chromium-driver \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY cfg ./cfg
COPY src ./src
COPY tools/m3u8-Downloader-Go ./tools/m3u8-Downloader-Go
COPY docker-web.py ./
COPY web-115/dist ./web-115/dist

# Cython 加固: 主程序编译为 .so 并删除源码,仅保留一行加载壳(镜像内无可读业务逻辑)
RUN pip install --no-cache-dir cython setuptools \
 && apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev && rm -rf /var/lib/apt/lists/* \
 && cp docker-web.py _app_main.py \
 && cythonize -3 -i _app_main.py \
 && rm -rf build _app_main.py _app_main.c \
 && printf 'from _app_main import app\n' > docker-web.py

RUN chmod +x ./tools/m3u8-Downloader-Go

ENV PYTHONUNBUFFERED=1 DATA_DIR=/data MEDIA_DIR=/media
EXPOSE 8788
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8788/api/health', timeout=3)"

CMD ["gunicorn", "--workers", "1", "--threads", "8", "--timeout", "0", "--bind", "0.0.0.0:8788", "docker-web:app"]
