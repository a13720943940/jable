# 留空则直连；站点访问受限时填写代理，例如 http://192.168.2.50:7890
HTTP_PROXY=

# 必填：公网可访问的授权吊销名单地址。主程序会定期拉取该地址，实现远程吊销。
LICENSE_REVOCATION_URL=http://v6.814000.xyz:8789/revocation.json

# 可选：Jable Cloudflare 验证 Cookie。也可部署后从网页“服务设置”填写。
JABLE_COOKIE=

# 可选：自定义刮削源，使用英文逗号分隔
SCRAPER_SOURCES=www.javbus.com,www.busdmm.ink,www.dmmsee.bond

# 可选：您自己的 115 授权中转服务。也可部署后从网页“服务设置”填写。
CLOUD115_MODE=bridge
CLOUD115_ENDPOINT=
CLOUD115_TOKEN=

# 可选：切换为 CLOUD115_MODE=cookie 时使用；也可部署后从网页粘贴 Cookie 或扫码登录。
CLOUD115_COOKIE=

# 可选：黄果站点地址（默认使用可用镜像；主站可直连时可改回 https://huangguoai.com）
HUANGGUO_SITE=https://thu.fdxqupvz.cc
